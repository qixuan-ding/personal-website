---
import BaseLayout from "./BaseLayout.astro";
import ArticleStar from "../components/ArticleStar.astro";

interface Props {
  title: string;
  publishedAt: string;
  updatedAt?: string;
  description?: string;
}

const { title, publishedAt, updatedAt, description } = Astro.props;
const displayedDate = updatedAt ?? publishedAt;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(displayedDate));
---

<BaseLayout title={`${title} | Qixuan Ding`} description={description} reading>
  <article>
    <header class="article-header">
      <h1>{title}</h1>
      <time class="muted" datetime={displayedDate}>
        {formattedDate}
      </time>
    </header>

    <div class="prose">
      <slot />
    </div>

    <a class="back-to-writing" href="/writing">
      Back to writing
    </a>
  </article>
  <ArticleStar />
</BaseLayout>

<style>
  article {
    padding-bottom: 5rem;
  }
</style>
