{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qixuan-ding",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "d1_databases": [{ "binding": "STARS_DB" }],
}
